[cas]
master_key = "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF"

[tunelith]
# tunelithd, the daemon of Tunelith (https://github.com/siketyan/tunelith)
# holding the tuners; every channel is tuned on a free one it picks. The whole
# section may be left out.
# The socket of tunelithd. Defaults to the user's if there is one, else the
# system's.
# socket = "/run/tunelith/tunelithd.sock"
# Whether to power the dish's converter while a satellite channel is tuned.
lnb = false

[database]
# Where the channels a scan found and the programme guide are kept. Defaults to
# a SQLite database in the working directory; the scheme picks the backend.
url = "sqlite://chibitv.db"

[storage]
# Where recordings are kept. Defaults to `./recordings` in the working
# directory.
type = "directory"
path = "./recordings"
