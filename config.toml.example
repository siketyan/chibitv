[cas]
master_key = "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF"

[[tuners]]
type = "dvb"
adapter_num = 0
frontend_num = 0

# Windows only. The DLL reads its own tuning parameters from the .ini file
# sitting next to it.
[[tuners]]
type = "bon"
path = 'C:\BonDriver\BonDriver_BDA.dll'

[[channels]]
name = "BS Example"
delivery_system = "ISDB-S"
frequency = 1318000
stream_id = 0x40F1

[[channels]]
name = "Terrestrial Example"
delivery_system = "ISDB-T"
frequency = 551142857
# Optional. Defaults to 6000000.
bandwidth_hz = 6000000

# A BonDriver holds the tuning parameters itself, so a channel only names the
# tuning space and channel numbers it enumerates. The delivery system still has
# to be named: ISDB-T carries MPEG-2 TS and ISDB-S carries MMT/TLV.
[[channels]]
name = "BonDriver Terrestrial Example"
delivery_system = "Bon-ISDB-T"
space = 0
channel = 0

[[channels]]
name = "BonDriver 4K Example"
delivery_system = "Bon-ISDB-S"
space = 0
channel = 1

[database]
# Defaults to a SQLite database in the working directory. The scheme picks the
# backend.
url = "sqlite://chibitv.db"

[storage]
# Where recordings are kept. Defaults to `./recordings` in the working
# directory.
type = "directory"
path = "./recordings"
