# Optional. Required by every subcommand that descrambles a stream, which the
# `tuner` subcommand never does.
[cas]
master_key = "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF"

[[tuners]]
type = "dvb"
adapter_num = 0
frontend_num = 0

# A tuner of another chibitv instance running in tuner mode.
# [[tuners]]
# type = "remote"
# address = "http://tuner.local:3002"
# Optional. Defaults to any available tuner of that instance.
# tuner_id = 0

[[channels]]
name = "BS Example"
delivery_system = "ISDB-S"
frequency = 1318000
stream_id = 0x40F1

[[channels]]
name = "Terrestrial Example"
delivery_system = "ISDB-T"
frequency = 551142857
# Optional. Defaults to 6000000.
bandwidth_hz = 6000000
